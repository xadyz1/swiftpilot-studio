# Self-hosted Postiz Public API
# Use the URL that serves your Postiz backend; the adapter adds /api/public/v1 when needed.
POSTIZ_BASE_URL=https://postiz.swiftapps.cloud
# Create this in Postiz Settings. Keep it server-side; never expose it to Vite/browser code.
POSTIZ_API_KEY=your-postiz-api-key
POSTIZ_MCP=https://postiz.swiftapps.cloud/api/mcp/your-mcp-key

# Optional OpenAI-compatible generation provider (server-side only). Leave unset to use Manus built-in LLM.
# A localhost URL is reachable only from the studio server, not from the browser.
LLM_BASE_URL=http://192.168.1.118:3001/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=auto

SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="mail@swiftapps.cloud"
SMTP_PASS="your-smtp-password"
SMTP_FROM="SwiftApps Ecosystem by Golden Creative ® <mail@swiftapps.cloud>"

DAILY_API_KEY="your-daily-api-key"

NEXT_PUBLIC_APP_URL="https://swiftcal.pt"

STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PORTAL_LINK="https://billing.stripe.com/p/login/4gM6oI2bd0gmdfV3Ib1ck00"
NEXT_PUBLIC_STRIPE_FEE_PERCENTAGE="0.5"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

NEXT_BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com/swiftapps"
NEXT_BUNNY_API_KEY="your-bunny-storage-key"
NEXT_BUNNY_PULL_ZONE="https://swiftapps.b-cdn.net/"

# --- SwiftPilot Social Studio ---
# SQLite workspace database (file path or file: URL)
DATABASE_URL=./data/app.db
# Comma-separated master admin emails (auto-admin on first sign-in)
MASTER_EMAILS=ivandro.work@gmail.com
# Session signing secret — set a strong random value in production
SESSION_SECRET=change-me-in-production
# Public app URL used in email templates
APP_URL=https://studio.swiftapps.cloud
# Server port (Coolify sets PORT automatically)
PORT=3000
